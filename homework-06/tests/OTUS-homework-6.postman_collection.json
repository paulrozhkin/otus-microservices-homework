  "item": [
    {
      "name": "01 Register user 1",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = `${Date.now()}_${pm.variables.replaceIn('{{$randomInt}}')}`;",
              "pm.collectionVariables.set('user1Login', `user1_${suffix}`);",
              "pm.collectionVariables.set('user1Password', `pass_${suffix}`);",
              "pm.collectionVariables.set('user1Email', `user1_${suffix}@example.com`);",
              "pm.collectionVariables.set('user1FirstName', `First_${suffix}`);",
              "pm.collectionVariables.set('user1LastName', `Last_${suffix}`);",
              "pm.collectionVariables.set('user1Phone', `+7100${pm.variables.replaceIn('{{$randomInt}}')}`);",
              "pm.collectionVariables.set('user1UpdatedFirstName', `Updated_${suffix}`);",
              "pm.collectionVariables.set('user1UpdatedLastName', `Profile_${suffix}`);",
              "pm.collectionVariables.set('user1UpdatedEmail', `updated_user1_${suffix}@example.com`);",
              "pm.collectionVariables.set('user1UpdatedPhone', `+7200${pm.variables.replaceIn('{{$randomInt}}')}`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('user1Id', json.id);",
              "",
              "pm.test('registered user 1 has expected data', function () {",
              "    pm.expect(json.id).to.be.a('number');",
              "    pm.expect(json.username).to.eql(pm.collectionVariables.get('user1Login'));",
              "    pm.expect(json.email).to.eql(pm.collectionVariables.get('user1Email'));",
              "    pm.expect(json.roles).to.include('user');",
              "    pm.expect(json).to.not.have.property('password');",
              "    pm.expect(json).to.not.have.property('passwordHash');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"login\": \"{{user1Login}}\",\n  \"password\": \"{{user1Password}}\",\n  \"firstName\": \"{{user1FirstName}}\",\n  \"lastName\": \"{{user1LastName}}\",\n  \"email\": \"{{user1Email}}\",\n  \"phone\": \"{{user1Phone}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://{{baseUrl}}/register",
          "protocol": "http",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "register"
          ]
        }
      },
      "response": []
    },
