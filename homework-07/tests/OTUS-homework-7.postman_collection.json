    {
      "name": "03 Create an order with sufficient funds",
      "item": [
        {
          "name": "06 Create paid order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('order creation returns 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('successfulOrderId', json.id);",
                  "pm.test('order was paid', function () {",
                  "    pm.expect(json.id).to.be.a('string').and.not.empty;",
                  "    pm.expect(json.userId).to.eql(Number(pm.collectionVariables.get('userId')));",
                  "    pm.expect(json.price).to.eql(Number(pm.collectionVariables.get('successfulOrderPrice')));",
                  "    pm.expect(json.status).to.eql('paid');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": {{successfulOrderPrice}}\n}"
            },
            "url": {
              "raw": "http://{{baseUrl}}/api/v1/orders",
              "protocol": "http",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders"
              ]
            }
          }
        },
        {
          "name": "07 Verify balance after paid order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('billing account request returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('paid order price was debited', function () {",
                  "    pm.expect(json.userId).to.eql(Number(pm.collectionVariables.get('userId')));",
                  "    pm.expect(json.balance).to.eql(Number(pm.collectionVariables.get('expectedBalanceAfterSuccess')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://{{baseUrl}}/api/v1/billing/account",
              "protocol": "http",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "billing",
                "account"
              ]
            }
          }
        },
        {
          "name": "08 Wait for paid order notification",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('notification request returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const notifications = pm.response.json();",
                  "const orderId = pm.collectionVariables.get('successfulOrderId');",
                  "const notification = notifications.find(item => item.orderId === orderId);",
                  "const attempt = Number(pm.collectionVariables.get('notificationPollAttempt'));",
                  "const maxAttempts = Number(pm.collectionVariables.get('notificationPollMaxAttempts'));",
                  "if (notification) {",
                  "    pm.collectionVariables.set('notificationPollAttempt', '0');",
                  "    pm.test('success notification was stored', function () {",
                  "        pm.expect(notification.userId).to.eql(Number(pm.collectionVariables.get('userId')));",
                  "        pm.expect(notification.email).to.eql(pm.collectionVariables.get('userEmail'));",
                  "        pm.expect(notification.orderStatus).to.eql('paid');",
                  "        pm.expect(notification.subject).to.eql('Order paid');",
                  "    });",
                  "} else if (attempt < maxAttempts) {",
                  "    pm.collectionVariables.set('notificationPollAttempt', String(attempt + 1));",
                  "    console.log(`[poll] paid notification is not ready, attempt ${attempt + 1}/${maxAttempts}`);",
                  "    pm.execution.setNextRequest(pm.info.requestName);",
                  "    setTimeout(function () {}, Number(pm.collectionVariables.get('notificationPollDelayMs')));",
                  "} else {",
                  "    pm.collectionVariables.set('notificationPollAttempt', '0');",
                  "    pm.test('success notification was stored before timeout', function () {",
                  "        pm.expect(notification, `notification for order ${orderId}`).to.exist;",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://{{baseUrl}}/api/v1/notifications",
              "protocol": "http",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "notifications"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "04 Create an order with insufficient funds",
      "item": [
        {
          "name": "09 Create rejected order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('rejected order creation returns 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('rejectedOrderId', json.id);",
                  "pm.test('order was rejected because funds are insufficient', function () {",
                  "    pm.expect(json.id).to.be.a('string').and.not.empty;",
                  "    pm.expect(json.userId).to.eql(Number(pm.collectionVariables.get('userId')));",
                  "    pm.expect(json.price).to.eql(Number(pm.collectionVariables.get('insufficientOrderPrice')));",
                  "    pm.expect(json.status).to.eql('rejected');",
                  "    pm.expect(json.failureReason).to.include('insufficient funds');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": {{insufficientOrderPrice}}\n}"
            },
            "url": {
              "raw": "http://{{baseUrl}}/api/v1/orders",
              "protocol": "http",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "orders"
              ]
            }
          }
        },
        {
          "name": "10 Verify balance after rejected order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('billing account request returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('rejected order did not change the balance', function () {",
                  "    pm.expect(json.userId).to.eql(Number(pm.collectionVariables.get('userId')));",
                  "    pm.expect(json.balance).to.eql(Number(pm.collectionVariables.get('expectedBalanceAfterSuccess')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://{{baseUrl}}/api/v1/billing/account",
              "protocol": "http",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "billing",
                "account"
              ]
            }
          }
        },
        {
          "name": "11 Wait for rejected order notification",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('notification request returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const notifications = pm.response.json();",
                  "const orderId = pm.collectionVariables.get('rejectedOrderId');",
                  "const notification = notifications.find(item => item.orderId === orderId);",
                  "const attempt = Number(pm.collectionVariables.get('notificationPollAttempt'));",
                  "const maxAttempts = Number(pm.collectionVariables.get('notificationPollMaxAttempts'));",
                  "if (notification) {",
                  "    pm.collectionVariables.set('notificationPollAttempt', '0');",
                  "    pm.test('rejection notification was stored', function () {",
                  "        pm.expect(notification.userId).to.eql(Number(pm.collectionVariables.get('userId')));",
                  "        pm.expect(notification.email).to.eql(pm.collectionVariables.get('userEmail'));",
                  "        pm.expect(notification.orderStatus).to.eql('rejected');",
                  "        pm.expect(notification.subject).to.eql('Order rejected');",
                  "        pm.expect(notification.body).to.include('insufficient funds');",
                  "    });",
                  "} else if (attempt < maxAttempts) {",
                  "    pm.collectionVariables.set('notificationPollAttempt', String(attempt + 1));",
                  "    console.log(`[poll] rejected notification is not ready, attempt ${attempt + 1}/${maxAttempts}`);",
                  "    pm.execution.setNextRequest(pm.info.requestName);",
                  "    setTimeout(function () {}, Number(pm.collectionVariables.get('notificationPollDelayMs')));",
                  "} else {",
                  "    pm.collectionVariables.set('notificationPollAttempt', '0');",
                  "    pm.test('rejection notification was stored before timeout', function () {",
                  "        pm.expect(notification, `notification for order ${orderId}`).to.exist;",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://{{baseUrl}}/api/v1/notifications",
              "protocol": "http",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "notifications"
              ]
            }
          }
        }
      ]
    }
