flowchart LR
    client["Client / Newman<br/>arch.homework"]

    subgraph cluster["Kubernetes namespace: online-store"]
        ingress["nginx Ingress<br/>cookie auth via /auth"]

        subgraph applications["Application services — 2 replicas each"]
            users["User Service<br/>:8000"]
            orders["Order Service<br/>:8002"]
            billing["Billing Service<br/>:8001"]
            notifications["Notification Service<br/>:8003<br/>consumer group: notification-service-v1"]
        end

        userdb[("User PostgreSQL<br/>users and sessions")]
        orderdb[("Order PostgreSQL<br/>orders")]
        billingdb[("Billing PostgreSQL<br/>accounts and operations")]
        notificationdb[("Notification PostgreSQL<br/>email messages")]

        kafka[["Kafka<br/>notification.commands.v1<br/>2 partitions"]]
        kafkaui["Kafbat UI"]
    end

    client -->|"public and protected HTTP API"| ingress
    ingress -->|"register, login, auth, profile"| users
    ingress -->|"orders API"| orders
    ingress -->|"billing API"| billing
    ingress -->|"notifications API"| notifications

    users -->|"users and sessions"| userdb
    users -->|"PUT /internal/v1/accounts/{userId}"| billing

    orders -->|"orders"| orderdb
    orders -->|"POST /internal/v1/payments<br/>operationId = order:{orderId}"| billing
    billing -->|"accounts and idempotent operations"| billingdb

    orders -->|"publish; key = orderId"| kafka
    kafka -->|"partition assignment and rebalance"| notifications
    notifications -->|"idempotent insert; PK = eventId"| notificationdb
    notifications -->|"list stored messages"| ingress

    kafkaui -.->|"inspect topics and consumer groups"| kafka

    classDef service fill:#e8f0fe,stroke:#3167b1,color:#13233a
    classDef database fill:#fff4d6,stroke:#a46b00,color:#352200
    classDef broker fill:#e8f7ec,stroke:#287a3e,color:#12351d
    class users,orders,billing,notifications service
    class userdb,orderdb,billingdb,notificationdb database
    class kafka broker
