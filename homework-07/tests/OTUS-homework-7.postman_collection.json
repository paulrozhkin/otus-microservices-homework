                  "pm.test('billing account request returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('billing account belongs to the registered user and starts empty', function () {",
                  "    pm.expect(json.userId).to.eql(Number(pm.collectionVariables.get('userId')));",
                  "    pm.expect(json.balance).to.eql(0);",
