      "item": [
        {
          "name": "Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"status is 201\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "const json = pm.response.json();\r",
                  "\r",
                  "pm.test(\"response has id\", function () {\r",
                  "    pm.expect(json.id).to.exist;\r",
                  "    pm.expect(json.id).to.be.a(\"number\");\r",
                  "});\r",
                  "\r",
                  "pm.collectionVariables.set(\"userId\", json.id);\r",
                  "\r",
                  "pm.test(\"created user has expected fields\", function () {\r",
                  "    pm.expect(json.username).to.include(\"postman_user_\");\r",
                  "    pm.expect(json.firstName).to.eql(\"paul\");\r",
                  "    pm.expect(json.lastName).to.eql(\"rozhkin\");\r",
                  "    pm.expect(json.email).to.eql(\"rozhkin@gmail.com\");\r",
                  "    pm.expect(json.phone).to.eql(\"123123123\");\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"username\": \"postman_user_{{$timestamp}}\",\r\n    \"firstName\": \"paul\",\r\n    \"lastName\": \"rozhkin\",\r\n    \"email\": \"rozhkin@gmail.com\",\r\n    \"phone\": \"123123123\"\r\n}",
