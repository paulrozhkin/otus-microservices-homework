{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "loki",
        "uid": "${lokiDatasource}"
      },
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({environment=~\"$environment\", service=~\"$service\"} |~ \"(?i)(error|failed|panic|500)\" [5m]))",
          "refId": "A"
        }
      ],
      "title": "Errors in the last 5 minutes",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${lokiDatasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "logs"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 16,
        "x": 8,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "expr": "sum by (service) (count_over_time({environment=~\"$environment\", service=~\"$service\"} [$__auto]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "title": "Log volume by service",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "${lokiDatasource}"
      },
      "gridPos": {
        "h": 18,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "id": 3,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{environment=~\"$environment\", service=~\"$service\"} |~ \"(?i)$search\"",
          "refId": "A"
        }
      ],
      "title": "Application logs",
      "type": "logs"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": [
    "online-store",
    "logs",
    "loki"
  ],
  "templating": {
    "list": [
      {
        "name": "lokiDatasource",
        "label": "Loki datasource",
        "query": "loki",
        "type": "datasource",
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "Loki",
          "value": "loki"
        }
      },
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "${lokiDatasource}"
        },
        "query": "label_values(environment)",
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "${lokiDatasource}"
        },
        "query": "label_values({environment=~\"$environment\"}, service)",
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "refresh": 2,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "search",
        "label": "Search",
        "type": "textbox",
        "query": "error|failed|panic|500",
        "current": {
          "selected": true,
          "text": "error|failed|panic|500",
          "value": "error|failed|panic|500"
        }
      }
    ]
  },
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Online Store Logs",
  "uid": "online-store-logs",
  "version": 2
}
