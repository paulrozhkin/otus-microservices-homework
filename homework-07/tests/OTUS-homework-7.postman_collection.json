              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('depositOperationId', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('deposit returns 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('deposit operation and resulting account are correct', function () {",
                  "    pm.expect(json.operationId).to.eql(pm.collectionVariables.get('depositOperationId'));",
                  "    pm.expect(json.account.userId).to.eql(Number(pm.collectionVariables.get('userId')));",
                  "    pm.expect(json.account.balance).to.eql(Number(pm.collectionVariables.get('depositAmount')));",
