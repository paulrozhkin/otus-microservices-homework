                  "pm.test(\"response is array\", function () {\r",
                  "    pm.expect(json).to.be.an(\"array\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"created user exists in list\", function () {\r",
                  "    pm.expect(json.some(user => user.id === userId)).to.eql(true);\r",
                  "});"
