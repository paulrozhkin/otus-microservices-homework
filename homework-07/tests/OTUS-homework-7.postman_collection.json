  "item": [
    {
      "name": "01 Create user and billing account",
      "item": [
        {
          "name": "01 Register user",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = `${Date.now()}_${pm.variables.replaceIn('{{$randomInt}}')}`;",
                  "pm.collectionVariables.set('userLogin', `billing_user_${suffix}`);",
                  "pm.collectionVariables.set('userPassword', `pass_${suffix}`);",
                  "pm.collectionVariables.set('userEmail', `billing_user_${suffix}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('user registration returns 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('userId', json.id);",
                  "",
                  "pm.test('registered user has expected data', function () {",
                  "    pm.expect(json.id).to.be.a('number').and.to.be.above(0);",
                  "    pm.expect(json.username).to.eql(pm.collectionVariables.get('userLogin'));",
                  "    pm.expect(json.email).to.eql(pm.collectionVariables.get('userEmail'));",
                  "    pm.expect(json).to.not.have.property('passwordHash');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"{{userLogin}}\",\n  \"password\": \"{{userPassword}}\",\n  \"email\": \"{{userEmail}}\",\n  \"firstName\": \"Billing\",\n  \"lastName\": \"User\",\n  \"phone\": \"+79990000000\"\n}"
            },
            "url": {
              "raw": "http://{{baseUrl}}/register",
              "protocol": "http",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "register"
              ]
            }
          }
        },
